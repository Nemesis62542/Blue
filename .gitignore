# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.slnx
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Digger の編集アンドゥ履歴
# ---------------------------------------------------------------------------
# DiggerSystem.UndoStackSize = 15 で個数は頭打ちだが、編集のたびに中身が入れ替わるため
# git 履歴が膨れ続ける。現行の voxel データはサフィックス無しの *.vox3 で、そちらは残す。
# ※ .internal は先頭がドットなので Unity は .meta を作らない（追跡対象は実体ファイルのみ）
/[Aa]ssets/DiggerData/**/*.vox3_v*
/[Aa]ssets/DiggerData/**/version_*.ver

# ---------------------------------------------------------------------------
# 負荷計測用のテストステージ
# ---------------------------------------------------------------------------
# Blue > World > Create 2km Test Stage でいつでも再生成できるため、コミットしない。
/[Aa]ssets/Stages/TestStage/
/[Aa]ssets/Stages/TestStage.meta

# ---------------------------------------------------------------------------
# ステージのベイク生成物
# ---------------------------------------------------------------------------
# 地形を詰めている間は焼き直しのたびに TerrainData とタイルシーンが差し替わるため、
# コミットしない。Source/ の画像とレシピから何度でも焼き直せる。
#
# ただし Digger で洞窟を掘り始めたら、そのステージの行を必ず消すこと。
# 掘削データは Assets/DiggerData/Scenes/(シーン名)/(DiggerSystem.guid)/ に置かれ、
# シーン名も guid もタイルシーン側のコンポーネントに保存された値なので、
# 別環境で焼き直すとタイルシーンが作り直されて、掘った洞窟が全て参照を失う。
#
# ステージごとに書いているのは、書き忘れて地形データが太るより、
# 消し忘れて掘削データを失う方が取り返しがつかないため。
/[Aa]ssets/Stages/Stage01/Generated/
/[Aa]ssets/Stages/Stage01/Generated.meta

# ---------------------------------------------------------------------------
# Profiler キャプチャ
# ---------------------------------------------------------------------------
# .data は数百MB〜数GBになる。CSV/レポートは .data から再生成できる。
/ProfilerCaptures/

# 計測用テストステージの Digger データ
# 地形もタイルシーンも ignore 対象なので、これだけ残しても参照先が無い。
# フォルダ名は DiggerMaster が置かれたシーン名から決まる。
/[Aa]ssets/DiggerData/Scenes/testStage/
/[Aa]ssets/DiggerData/Scenes/testStage.meta

# ---------------------------------------------------------------------------
# 水族館の動作確認用シーンと、その生成物
# ---------------------------------------------------------------------------
# Blue > Aquarium > Setup Test Scene が Aquarium.unity から作り直す。
# コミットするとビルダーを変えるたびに古くなり、コードとシーンが
# 食い違ったまま気づけない。クローン後は一度メニューを実行すること。
# 水槽の TankPieceData は手で調整する前提なので ignore しない。
/[Aa]ssets/Scenes/AquariumTest.unity
/[Aa]ssets/Scenes/AquariumTest.unity.meta
/[Aa]ssets/ScriptableObjects/Aquarium/TestFloor.asset
/[Aa]ssets/ScriptableObjects/Aquarium/TestFloor.asset.meta
/[Aa]ssets/ScriptableObjects/Aquarium/TestPath.asset
/[Aa]ssets/ScriptableObjects/Aquarium/TestPath.asset.meta
/[Aa]ssets/Prefab/Aquarium/Path/
/[Aa]ssets/Prefab/Aquarium/Path.meta
/[Aa]ssets/Prefab/UI/ExhibitEntry.prefab
/[Aa]ssets/Prefab/UI/ExhibitEntry.prefab.meta
